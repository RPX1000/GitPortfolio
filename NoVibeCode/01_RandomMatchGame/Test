import tkinter as tk
import random

# ---- Setting variables ------------------

numbergenerator = random.randint(1,5) # First button random generator
roll_counter = 0 # Variable to count the rolls

def numbergenerator2(): # this will pass through into matcher
    nm2 = random.randint(1,5)
    return nm2

def matcher():         # this takes number generator 2 and counter variable
    global roll_counter
    
    nm2 = numbergenerator2() # calls on its own function
    label2.config(text = nm2, fg = "Cyan") 
    roll_counter += 1
    if nm2 == numbergenerator:
        # label adjustments and message
        label3.config(text = "success!", fg = "Gold")
        label4.config(text = f"It took {roll_counter} rolls.", fg = "Yellow")

def nice_job():
    label.config(text = numbergenerator, fg = "Cyan")
    
# ------------------------------------------------------------------------

 # making the GUI
 # Starting it, giving its size, and title
    
root = tk.Tk()
root.geometry("250x250")
root.title("Number Matching Game")


# ------------------------------------------------------------------------

# Beginnging labels and button section

label = tk.Label(text = "Click to roll a number?", font = ("",11)) 
label.pack()

button1 = tk.Button(text = "Click here", command = nice_job).pack()

label2 = tk.Label(text = "Match this above!")
label2.pack()

button2 = tk.Button(text = "Click here", command = matcher)
button2.pack()

label3 = tk.Label(text = "Keep going!")
label3.pack()

label4 = tk.Label(text = "Let's see how many rolls this will take.")
label4.pack()

# ------------------------------------------------------------------------

# call the GUI program

tk.mainloop()

